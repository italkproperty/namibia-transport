# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase Postgres (Drizzle) -------------------------------------------
# Supabase dashboard: Project Settings > Database > Connection string > URI.
# Use the pooled connection (port 6543) for the app; the direct connection
# (port 5432) for migrations.
DATABASE_URL="postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres"

# --- Supabase client (auth / storage) --------------------------------------
# Supabase dashboard: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_ME.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# --- Internal admin --------------------------------------------------------
# Shared password gating /admin/bookings. Leave empty to keep the view closed.
# Temporary: replaced by Supabase Auth + row-level security in a later phase.
ADMIN_PASSWORD=""

# --- Site ------------------------------------------------------------------
# Canonical origin, used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: E.164 support number shown in the UI, e.g. +264811234567
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
