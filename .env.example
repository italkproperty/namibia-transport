# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase Postgres (Drizzle) -------------------------------------------
# Supabase dashboard: Connect > Connection string > Transaction pooler.
#
# Use the POOLER for the deployed app:
#   host     aws-0-<region>.pooler.supabase.com
#   port     6543
#   username postgres.<project-ref>     <- the ref suffix is required
#
# Do NOT use the direct connection (db.<ref>.supabase.co:5432) on Vercel. That
# host is IPv6-only and Vercel's functions have no IPv6 egress, so every query
# fails with ENOTFOUND. It is fine from a local machine, and from Supabase's
# own SQL editor, which is where migrations run.
DATABASE_URL="postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres"

# --- Supabase client (auth / storage) --------------------------------------
# Supabase dashboard: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_ME.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# --- Internal admin --------------------------------------------------------
# Shared password gating /admin/bookings. Leave empty to keep the view closed.
# Temporary: replaced by Supabase Auth + row-level security in a later phase.
ADMIN_PASSWORD=""

# --- Company identity (all optional; sections render once these exist) ------
# E.164 support WhatsApp, the primary channel, e.g. +264811234567
# NEXT_PUBLIC_SUPPORT_WHATSAPP is defined below under Site.
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_COMPANY_LOCATION="Windhoek, Namibia"
NEXT_PUBLIC_COMPANY_REGISTRATION=""
# Corporate quotations apply VAT only when this is set, e.g. 0.15 once
# VAT-registered. Empty = quotes are issued without VAT.
QUOTE_VAT_RATE=""

# --- Payments: PayToday (Nedbank Namibia) ----------------------------------
# Stripe and Paddle do not serve Namibian entities. PayToday settles in NAD.
# Keys come from PayToday Support (paytodaysupport@nedbank.com.na) or the
# Merchant Portal. All three are required — the private key alone does nothing.
#
# SERVER-ONLY. Note the absence of a NEXT_PUBLIC_ prefix: these must never
# reach a browser bundle. PayToday's own guide says so in §3.3, even though its
# React sample contradicts it. The SDK is driven server-side instead.
#
# Set to "paytoday" to take real money; anything else uses the stub adapter.
PAYMENT_PROVIDER="stub"
PAYTODAY_SHOP_KEY=""
PAYTODAY_SHOP_HANDLE=""
PAYTODAY_PRIVATE_KEY=""
# PayToday has no sandbox — "production" is the only environment there is.
PAYTODAY_ENVIRONMENT="production"
# PayToday requires an e-mail on every payment intent, but our booking form
# keeps e-mail optional. Receipts for those bookings land here.
PAYTODAY_FALLBACK_EMAIL=""
# Supply-chain controls for the SDK the server loads and executes.
# Vendor the file and point at it, and/or pin its SHA-256, before going live.
#   PAYTODAY_SDK_PATH="./vendor/paytoday-sdk.js"
#   PAYTODAY_SDK_SHA256="<sha256sum of the file>"
PAYTODAY_SDK_PATH=""
PAYTODAY_SDK_SHA256=""

# Which request headers to present. Their API is browser-shaped, and an
# earlier session guessed that the 403 at initialize() was a missing Origin
# and started inventing one. That guess is undocumented — nothing in their
# guide describes an origin or domain check — and it may be the cause rather
# than the cure: an Origin is what makes a server call look like a
# cross-origin browser call, and announcing a domain they do not have on file
# is a way for a recognised merchant to be refused anyway.
#
# So the default sends nothing we were not asked for. /admin/paytoday tries
# every variant in one run and tells you which one authenticates; set it here
# and redeploy.
#
#   none     nothing extra (the default)
#   site     Origin + Referer from NEXT_PUBLIC_SITE_URL
#   apex     the same without www.
#   www      the same with www.
#   browser  a browser User-Agent and no Origin
PAYTODAY_HEADER_VARIANT=""

# --- Maps: Mapbox ----------------------------------------------------------
# Public token (pk.…). It is meant to be in the browser — it signs static route
# maps and the pin-drop map — so restrict it by URL in the Mapbox console
# (Tokens > your token > URL restrictions) to your own domains. An
# unrestricted token can be used by anyone and billed to you.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Optional server-only token for Directions calls (`npm run routes:measure`),
# so route measurement does not spend the browser token's quota.
MAPBOX_SECRET_TOKEN=""

# --- Site ------------------------------------------------------------------
# Canonical origin, used for metadata, the sitemap and the URL PayToday returns
# travellers to. Set this to your custom domain in production.
# On Vercel, leaving it empty falls back to the project's own domain (the
# production domain in production, the deployment URL on a preview), so a
# forgotten value degrades to the right host rather than to localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: E.164 support number shown in the UI, e.g. +264811234567
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# ---------------------------------------------------------------- email
# Booking confirmations by email. WhatsApp is the primary channel; this is the
# backup, and the only one wired up today.
#
# SMTP rather than a transactional API because the mailbox already exists:
# bookings@namibiatransport.com is on Spacemail, and SPF and DKIM are already
# published for the domain — so this needs credentials and nothing else. A
# Resend or Postmark adapter slots in behind the same Messenger interface when
# volume justifies one.
#
# The stub stays the default. Email only sends when this is set to "smtp" AND
# every credential below is present; a half-configured environment warns and
# keeps stubbing rather than failing a booking.
MESSENGER_PROVIDER=
# Spacemail: mail.spacemail.com, port 465 (implicit TLS) or 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=bookings@namibiatransport.com
SMTP_PASSWORD=
# Must be a mailbox on the sending domain, or SPF and DKIM will not vouch for it.
MAIL_FROM="Namibia Transport <bookings@namibiatransport.com>"
# Where a traveller's reply lands, if not MAIL_FROM.
MAIL_REPLY_TO=

# ---------------------------------------------------------------- bank transfer
# Paying by EFT, which in Namibia is how most business money moves — and the
# only way anyone can pay while PayToday is refusing our account.
#
# These are server-only on purpose. The block renders server-side on the
# booking page, so the values never enter a browser bundle, and this repository
# is public: account details in a public repo are an invitation to invoice
# fraud. Set them in Vercel, not here.
#
# The block only appears when NAME, NUMBER and BRANCH are all set — a half
# configured block produces bounced transfers.
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=
# Optional. SWIFT lets someone pay from outside Namibia.
BANK_SWIFT=
BANK_NAME=

# ------------------------------------------------------------------ currency
# A figure in the reader's own currency beside every fare, for travellers who
# have no feel for the Namibian dollar. Never the amount owed: we bank in NAD
# and a foreign bank converts at its own rate on the day, so quoting a foreign
# price would be a number we cannot honour.
#
# The rand needs nothing here. The Namibian dollar is pegged at par to it, so
# N$650 is R650 exactly — that conversion is always offered and never stale.
#
# Each of these is N$ per one unit. Leave one blank and that currency is not
# offered at all, which is better than offering a stale one. Each is ignored
# unless it falls in its own plausible band, because a misplaced decimal —
# 1.82 where 18.2 was meant — would misquote every foreign traveller on the
# site by a factor of ten and nothing downstream would notice.
USD_RATE=            # 5–40
EUR_RATE=            # 6–45
GBP_RATE=            # 7–55

# yyyy-mm-dd you last set them. Shown next to the figure, because an undated
# approximation quietly becomes last year's rate.
FX_RATE_AS_AT=

# The single-currency name this replaced. Still read as a fallback for
# FX_RATE_AS_AT so an existing deployment does not lose its date on a push.
USD_RATE_AS_AT=

